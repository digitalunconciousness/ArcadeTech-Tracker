# Copy to .env (git-ignored) for local dev; scripts/devdb.sh env prints the DB lines.
# Prod: /etc/shop-hub/shop-hub.env (root:shop-hub 640) holds the same keys, unquoted.
DATABASE_URL=postgresql+psycopg://shop@127.0.0.1:5433/shop
MIGRATE_DATABASE_URL=postgresql+psycopg://shop_owner@127.0.0.1:5433/shop
PGPASSFILE=<path printed by scripts/devdb.sh env>
SECRET_KEY=<python -c 'import secrets; print(secrets.token_hex(32))'>
# IANA zone the business runs in; displays and document-number years use it.
SHOP_TZ=<Area/City>
SHOP_BASE_URL=http://127.0.0.1:5000
# Local plain-http dev only. Leave unset (secure cookies) everywhere else.
SHOP_COOKIE_SECURE=0
