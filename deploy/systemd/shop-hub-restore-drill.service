# Monthly restore drill: restores the newest nightly backup into shop_restore_test.
# Runs as shop-hub (it reads the backups) with the shop_drill role, which owns only the
# scratch database. systemd reads restore.env as root, so the file stays root-only.
[Unit]
Description=shop-hub monthly restore drill
After=network-online.target shop-hub-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=shop-hub
Group=shop-hub
EnvironmentFile=/etc/shop-hub/restore.env
ExecStart=/opt/shop-hub/scripts/restore_drill.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
# 2026-11-17's security pass: the kernel out of reach and no capabilities. Devices, address families and system calls are
# left open because the job runs psql and tar on the owner's restore target, and what that needs isn't known here.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
