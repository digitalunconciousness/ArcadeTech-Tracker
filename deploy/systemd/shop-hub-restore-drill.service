# Monthly restore drill: restores the newest nightly backup into shop_restore_test.
# Runs as shop-hub (it reads the backups) with the shop_drill role, which owns only the
# scratch database. systemd reads restore.env as root, so the file stays root-only.
[Unit]
Description=shop-hub monthly restore drill
After=network-online.target shop-hub-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=shop-hub
Group=shop-hub
EnvironmentFile=/etc/shop-hub/restore.env
ExecStart=/opt/shop-hub/scripts/restore_drill.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
